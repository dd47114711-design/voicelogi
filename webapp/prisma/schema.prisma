// KoeHaisha フェーズ1: 出欠札のデジタル化
// 詳細は docs/02-phase1-design.md を参照

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Department {
  DOBOKU // 土木
  UNYU // 運輸
}

// 現場の業務区分。社員の Department とは無関係の独立した分類。
enum WorkCategory {
  DOBOKU // 土木
  UNYU // 運輸
  HOSO // 舗装
  SONOTA // その他
}

// 現場の発注区分(誰が発注したか)。業務区分と組み合わせて使う。
enum OrderCategory {
  KOKYO // 公共
  MINKAN // 民間
  FUMEI // 不明
}

model Status {
  id        String   @id
  label     String
  color     String
  icon      String   @default("⚪")
  sortOrder Int      @map("sort_order")
  employees Employee[]
  history   StatusHistory[] @relation("ToStatus")
  historyFrom StatusHistory[] @relation("FromStatus")

  @@map("statuses")
}

model Employee {
  id                 String     @id @default(uuid())
  name               String
  // 本来の所属(人事上の所属、基本的に変わらない)
  homeDepartment     Department @map("home_department")
  // 当日ボードに表示する所属。通常は homeDepartment と同じ値。
  // 応援等で部門をまたぐ将来ニーズのため分離しているが、
  // フェーズ1では社員管理画面での編集でのみ変更する。
  currentDepartment  Department @map("current_department")
  displayOrder       Int        @map("display_order")
  isActive           Boolean    @default(true) @map("is_active")
  currentStatus      Status     @relation(fields: [currentStatusId], references: [id])
  currentStatusId    String     @map("current_status_id")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  history            StatusHistory[]

  @@map("employees")
}

model StatusHistory {
  id            String   @id @default(uuid())
  employee      Employee @relation(fields: [employeeId], references: [id])
  employeeId    String   @map("employee_id")
  fromStatus    Status?  @relation("FromStatus", fields: [fromStatusId], references: [id])
  fromStatusId  String?  @map("from_status_id")
  toStatus      Status   @relation("ToStatus", fields: [toStatusId], references: [id])
  toStatusId    String   @map("to_status_id")
  changedAt     DateTime @default(now()) @map("changed_at")

  @@map("status_history")
}

// ==== フェーズ2A: 現場マスター ====
// 詳細は docs/07-phase2-design-v2.md を参照

model Client {
  id       String  @id @default(uuid())
  name     String
  isActive Boolean @default(true) @map("is_active")
  sites    Site[]

  @@map("clients")
}

model Site {
  id            String        @id @default(uuid())
  client        Client        @relation(fields: [clientId], references: [id])
  clientId      String        @map("client_id")
  name          String
  workCategory  WorkCategory  @map("work_category")
  orderCategory OrderCategory @map("order_category")
  notes         String?
  isActive      Boolean       @default(true) @map("is_active")
  needsReview   Boolean       @default(false) @map("needs_review")
  reviewReason  String?       @map("review_reason")
  reviewedAt    DateTime?     @map("reviewed_at")
  prices        SitePrice[]

  @@map("sites")
}

model SitePrice {
  id           String    @id @default(uuid())
  site         Site      @relation(fields: [siteId], references: [id])
  siteId       String    @map("site_id")
  // 車種(例: 10tダンプ, 4t車)。null = 車種を問わない単価。
  vehicleType  String?   @map("vehicle_type")
  dayPrice     Int?      @map("day_price")
  nightPrice   Int?      @map("night_price")
  otherPrice   Int?      @map("other_price")
  validFrom    DateTime? @map("valid_from")
  validTo      DateTime? @map("valid_to")
  notes        String?
  needsReview  Boolean   @default(false) @map("needs_review")
  reviewReason String?   @map("review_reason")
  reviewedAt   DateTime? @map("reviewed_at")

  @@map("site_prices")
}
